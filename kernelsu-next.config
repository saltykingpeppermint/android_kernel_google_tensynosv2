# SPDX-License-Identifier: GPL-2.0
#
# KernelSU Next build integration for Android GKI
# Include this from your build.config or device build config

# KernelSU Next configuration
CONFIG_KSU=y
CONFIG_KSU_DEBUG=n
CONFIG_KSU_DISABLE_MANAGER=n
CONFIG_KSU_DISABLE_POLICY=n

# Required dependencies for KernelSU Next
CONFIG_KPROBES=y
CONFIG_KALLSYMS=y
CONFIG_KALLSYMS_ALL=y
CONFIG_EXT4_FS=y
CONFIG_EXT4_FS_SECURITY=y
CONFIG_EXT4_FS_POSIX_ACL=y

# Security features needed
CONFIG_SECURITY=y
CONFIG_SECURITY_SELINUX=y
CONFIG_SECURITY_SELINUX_BOOTPARAM=y
CONFIG_SECURITY_SELINUX_DEVELOP=y
CONFIG_SECURITY_SELINUX_AVC_STATS=y
CONFIG_SECURITY_SELINUX_CHECKREQPROT_VALUE=1
CONFIG_SECURITY_SELINUX_SIDTAB_HASH_BITS=9
CONFIG_SECURITY_SELINUX_POLICYDB_VERSION_MAX=32

# Filesystem support for modules
CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y
CONFIG_MODULE_FORCE_UNLOAD=y
CONFIG_MODVERSIONS=y
CONFIG_MODULE_SRCVERSION_ALL=y
CONFIG_MODULE_SIG=y
CONFIG_MODULE_SIG_ALL=y
CONFIG_MODULE_SIG_SHA512=y
CONFIG_MODULE_SIG_HASH="sha512"

# OverlayFS for KernelSU module system
CONFIG_OVERLAY_FS=y
CONFIG_OVERLAY_FS_REDIRECT_DIR=y
CONFIG_OVERLAY_FS_INDEX=y
CONFIG_OVERLAY_FS_XINO_AUTO=y
CONFIG_OVERLAY_FS_METACOPY=y

# Android binder (required for manager communication)
CONFIG_ANDROID_BINDER_IPC=y
CONFIG_ANDROID_BINDERFS=y
CONFIG_ANDROID_BINDER_DEVICES="binder,hwbinder,vndbinder"

# Debug features
CONFIG_DEBUG_FS=y
CONFIG_DEBUG_KERNEL=y
CONFIG_DEBUG_INFO=y
CONFIG_DEBUG_INFO_BTF=y
CONFIG_DEBUG_INFO_BTF_MODULES=y

# Power saving exclusion configs (our additions)
CONFIG_BLUETOOTH_POWERSAVE_EXCLUDE=y
CONFIG_WIFI_POWERSAVE_EXCLUDE=y

# Restart reliability
CONFIG_DEBUG_REBOOT=y

# Local version identifier
CONFIG_LOCALVERSION="-kernelsu-next"
CONFIG_LOCALVERSION_AUTO=n

# KernelSU Next version info (will be auto-generated by Kbuild)
# KSU_VERSION=30000+
# KSU_VERSION_TAG="v0.0.1"

# Architecture specific
# For arm64 (Tensor G3)
CONFIG_ARM64=y
CONFIG_64BIT=y
CONFIG_MMU=y
CONFIG_ARM64_PAGE_SHIFT=12
CONFIG_ARM64_CONT_SHIFT=4
CONFIG_ARM64_VA_BITS=48
CONFIG_ARM64_PA_BITS=48
CONFIG_ARM64_VA_BITS_52=n

# Tensor G3 (zuma) specific
CONFIG_SOC_GOOGLE=y
CONFIG_SOC_ZUMA=y
CONFIG_SOC_GS_CHIPID=y
CONFIG_GS_ACPM=y
CONFIG_EXYNOS_PM=y
CONFIG_EXYNOS_CPUPM=y

# Bluetooth (nitrous driver)
CONFIG_NITROUS=m

# WiFi (bcmdhd driver)
CONFIG_BCMDHD=m
CONFIG_BCMDHD_PCIE=y
CONFIG_BCM4389=y
CONFIG_DHD_OF_SUPPORT=y
CONFIG_BROADCOM_WIFI_RESERVED_MEM=y
CONFIG_DHD_USE_STATIC_BUF=y
CONFIG_DHD_USE_SCHED_SCAN=y
CONFIG_BCMDHD_OOB_HOST_WAKE=y
CONFIG_BCMDHD_GET_OOB_STATE=y

# Power management
CONFIG_GOOGLE_BCL=y
CONFIG_PIXEL_POWER_REBOOT=y

# Display
CONFIG_DRM=y
CONFIG_DRM_SAMSUNG=y
CONFIG_GS_DRM_PANEL_UNIFIED=y

# Trusty TEE
CONFIG_TRUSTY=y
CONFIG_TRUSTY_DMA_BUF_FFA_TAG=y
CONFIG_TRUSTY_CRASH_IS_PANIC=y

# Fingerprint
CONFIG_GOODIX_FINGERPRINT=m
CONFIG_FPS_TOUCH_HANDLER=m

# Touch
CONFIG_TOUCH_COMMON=m
CONFIG_TOUCH_FTS_FTM5=m

# Radio
CONFIG_RADIO_SAMSUNG_S5300=m

# BMS
CONFIG_GOOGLE_LOGBUFFER=m
CONFIG_EXYNOS_BTS=m
CONFIG_S5910=m
CONFIG_SBB_MUX=m
CONFIG_SUBSYSTEM_COREDUMP=m

# Performance
CONFIG_GS_PERF_MON=m
CONFIG_GS_MEMLAT_GOVERNOR=m
CONFIG_GS_DSULAT_GOVERNOR=m

# Thermal
CONFIG_GS_THERMAL_V3=y
CONFIG_EXYNOS_ACPM_THERMAL=m
CONFIG_EXYNOS_CPU_THERMAL=m
CONFIG_GPU_THERMAL=m
CONFIG_ISP_THERMAL=m
CONFIG_GSOC_PMIC_THERMAL_CAMBRIA=m

# USB
CONFIG_USB_XHCI_EXYNOS=m
CONFIG_USB_XHCI_GOOG_DMA=m
CONFIG_USB_DWC3_EXYNOS_GS=m

# UFS
CONFIG_SCSI_UFS_EXYNOS_GS=m
CONFIG_SCSI_UFS_CRYPTO_SW_KEYS_MODE=y

# PCIe
CONFIG_PCI_EXYNOS_GS=m
CONFIG_PCI_EXYNOS_CAL_ZUMA=m

# IOMMU
CONFIG_SAMSUNG_IOMMU_V9=m
CONFIG_EXYNOS_PCIE_IOMMU=m
CONFIG_IOVAD_VENDOR_HOOKS=m

# Regulator
CONFIG_REGULATOR_S2MPG14=m
CONFIG_REGULATOR_S2MPG15=m
CONFIG_POWERMETER_S2MPG14=m
CONFIG_POWERMETER_S2MPG15=m
CONFIG_REGULATOR_SLG51002=m
CONFIG_REGULATOR_RT6160_GS=m

# RTC
CONFIG_RTC_DRV_S2MPG14=m

# MFD
CONFIG_MFD_S2MPG14=m
CONFIG_MFD_S2MPG15=m
CONFIG_MFD_SLG51002=m

# Video
CONFIG_EXYNOS_GRAPHICS_G2D=m
CONFIG_VIDEO_EXYNOS_MFC=m
CONFIG_VIDEO_EXYNOS_SMFC=m

# Clock
CONFIG_EXYNOS_GS_COMMON_CLK=m
CONFIG_CLKSRC_EXYNOS_MCT_V3_GS=m

# CPufreq
CONFIG_ARM_EXYNOS_ACME=m

# Devfreq
CONFIG_ARM_EXYNOS_DEVFREQ=m
CONFIG_EXYNOS_ALT_DVFS=y

# DMA
CONFIG_SAMSUNG_DMADEV=m

# I2C
CONFIG_I2C_EXYNOS5_GS=m
CONFIG_I2C_ACPM=m

# SPI
CONFIG_SPI_S3C64XX_GS=m

# SPMI
CONFIG_SPMI_BITBANG=m

# PHY
CONFIG_PHY_EXYNOS_EUSB_REPEATER=m
CONFIG_PHY_EXYNOS_USBDRD_EUSB=m
CONFIG_PHY_EXYNOS_MIPI=m
CONFIG_PHY_EXYNOS_MIPI_DSIM=m

# Pinctrl
CONFIG_PINCTRL_EXYNOS_GS=m
CONFIG_PINCTRL_SLG51002=m

# Serial
CONFIG_SERIAL_EXYNOS=m

# Watchdog
CONFIG_S3C2410_WATCHDOG_GS=m
CONFIG_S3C2410_SHUTDOWN_REBOOT=y

# Input
CONFIG_INPUT_KEYDEBUG=m
CONFIG_INPUT_STMVL53L1=m
CONFIG_KEYBOARD_S2MPG14=m

# IIO
CONFIG_ODPM=m

# ZRAM
CONFIG_ZRAM_GS=m
CONFIG_ZCOMP_CPU=m
CONFIG_ZCOMP_EH=m
CONFIG_ZRAM_GS_WRITEBACK=y

# DMA-buf heaps
CONFIG_DMABUF_SAMSUNG_HEAPS=m
CONFIG_DMABUF_HEAPS_SAMSUNG_CHUNK=y
CONFIG_DMABUF_HEAPS_SAMSUNG_CMA=y
CONFIG_DMABUF_HEAPS_SAMSUNG_CARVEOUT=y
CONFIG_DMABUF_HEAPS_GOOGLE_GCMA=y
CONFIG_DMABUF_HEAPS_SAMSUNG_SYSTEM=y

# Media
CONFIG_MEDIA_PLATFORM_DRIVERS=y

# Coredump
CONFIG_DEBUG_SNAPSHOT=y
CONFIG_DEBUG_SNAPSHOT_NR_CPUS=9
CONFIG_DEBUG_SNAPSHOT_DEBUG_KINFO=m
CONFIG_EXYNOS_EHLD=m
CONFIG_EXYNOS_DEBUG_TEST=m
CONFIG_PIXEL_DEBUG_TEST=m
CONFIG_EXYNOS_ITMON=m
CONFIG_EXYNOS_CORESIGHT=m
CONFIG_EXYNOS_ECC_HANDLER=m
CONFIG_EXYNOS_CORESIGHT_ETM=m
CONFIG_EXYNOS_CORESIGHT_ETF=y
CONFIG_EXYNOS_CORESIGHT_ETR=y
CONFIG_EXYNOS_ADV_TRACER=m
CONFIG_EXYNOS_ADV_TRACER_S2D=m
CONFIG_PIXEL_BOOT_METRICS=m
CONFIG_PIXEL_SUSPEND_DIAG=m
CONFIG_GS_SJTAG=m
CONFIG_BOOKERCI=m
CONFIG_ETM2DRAM=m
CONFIG_EXYNOS_GNSS_IF_SPI=m
CONFIG_GCMA=m
CONFIG_SMRA=m
CONFIG_VH_SYSTRACE=m
CONFIG_PIXEL_EM=m
CONFIG_PIXEL_METRICS=m
CONFIG_VH_FS=m
CONFIG_VH_MM=m
CONFIG_VH_CGROUP=m
CONFIG_VH_THERMAL=m
CONFIG_VH_SCHED=m
CONFIG_VH_PREEMPTIRQ_TRACEPOINTS=m
CONFIG_TICK_DRIVEN_LATGOV=y
CONFIG_HARDLOCKUP_DEBUG=m
CONFIG_HARDLOCKUP_WATCHDOG=m
CONFIG_DBGCORE_DUMP=m
CONFIG_PKVM_S2MPU_V9=m
CONFIG_KERNEL_TOP=m
CONFIG_GOOGLE_MODEMCTL=m
CONFIG_TYPEC_COOLING_DEV=m
CONFIG_TYPEC_MAX77759=m
CONFIG_TYPEC_MAX77759_CONTAMINANT=m
CONFIG_TYPEC_MAX77779_CONTAMINANT=m
CONFIG_USB_CONFIGFS_F_DM=m
CONFIG_USB_CONFIGFS_F_ETR_MIU=m
CONFIG_EXYNOS_CONTENT_PATH_PROTECTION=m
CONFIG_PERF_TRACE_CTRS=m
CONFIG_GSA=m
CONFIG_GSA_PKVM=y
CONFIG_GSA_GSC=y
CONFIG_TZ_PROT=m